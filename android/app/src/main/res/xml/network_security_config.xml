<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许自定义中转/局域网 HTTP 端点；HTTPS 仍只信任系统根证书 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
